{
	"name": "country-search",
	"version": "1.0.0",
	"description": "",
	"homepage": "https://github.com/DmitriyHnatiuk/country-search#readme",
	"license": "ISC",
	"type": "module",
	"main": "index.js",
	"lint-staged": {
		"*.{js,ts}": [
			"npx eslint"
		],
		"*.{js,css,md,json,html}": [
			"npx prettier --check"
		]
	},
	"scripts": {
		"test": "vitest run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix && npm run format",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky install",
		"build": "npx esbuild ./src/index.ts --bundle --format=esm --outfile=index.js"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.14.0",
		"husky": "^8.0.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"typescript-eslint": "^8.36.0",
		"vitest": "^5.1.0"
	}
}
